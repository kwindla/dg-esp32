# Guard at the partition boundary, immediately before every write/erase.
idf_component_get_property(fs_dir joltwallet__littlefs COMPONENT_DIR)
idf_component_get_property(fs_lib joltwallet__littlefs COMPONENT_LIB)
file(READ "${fs_dir}/src/littlefs_esp_part.c" fs_source)
foreach(operation write erase_range)
    set(old "esp_err_t err = esp_partition_${operation}(")
    string(FIND "${fs_source}" "${old}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Review display LittleFS flash guard")
    endif()
    string(REPLACE "${old}" "if (flash_mmap_remain() || (dg_display_flash_write_allowed && !dg_display_flash_write_allowed())) { ESP_LOGE(ESP_LITTLEFS_TAG, \"storage_unavailable: flash mmap\"); return LFS_ERR_IO; }\n    ${old}" fs_source "${fs_source}")
endforeach()
# Instrument the full synchronous read/prog/erase operation at the block boundary.
set(op_number 0)
foreach(operation read write erase_range)
    if(operation STREQUAL "erase_range")
        set(call "esp_partition_erase_range(efs->partition, part_off, c->block_size)")
    else()
        set(call "esp_partition_${operation}(efs->partition, part_off, buffer, size)")
    endif()
    set(old "esp_err_t err = ${call};")
    string(FIND "${fs_source}" "${old}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Review display LittleFS block instrumentation")
    endif()
    string(REPLACE "${old}" "if (dg_display_flash_begin && !dg_display_flash_begin(${op_number})) return LFS_ERR_IO;\n    esp_err_t err = ${call};\n    if (dg_display_flash_end) dg_display_flash_end(${op_number}, err);" fs_source "${fs_source}")
    math(EXPR op_number "${op_number}+1")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/display-littlefs-guard")
set(guard_file "${CMAKE_BINARY_DIR}/display-littlefs-guard/littlefs_esp_part.c")
file(WRITE "${guard_file}" "#include \"esp_private/flash_mmap.h\"\nextern bool dg_display_flash_write_allowed(void) __attribute__((weak));\nextern bool dg_display_flash_begin(unsigned) __attribute__((weak));\nextern void dg_display_flash_end(unsigned, int) __attribute__((weak));\n${fs_source}")
get_target_property(fs_sources ${fs_lib} SOURCES)
list(FILTER fs_sources EXCLUDE REGEX "littlefs_esp_part\\.c$")
set_property(TARGET ${fs_lib} PROPERTY SOURCES "${fs_sources};${guard_file}")
set_source_files_properties("${guard_file}" TARGET_DIRECTORY ${fs_lib} PROPERTIES COMPILE_FLAGS "-DLFS_CONFIG=lfs_config.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fs_dir}/src/littlefs_esp_part.c")
