menu "DG configuration"
config DG_WIFI_SSID
    string "WiFi SSID"
    default ""
config DG_WIFI_PASSWORD
    string "WiFi password"
    default ""
config DG_SERVER_URL
    string "Server URL"
    default ""
endmenu

config SPIKE_PTS_MS
    bool "Use millisecond PTS instead of initial 48 kHz tick experiment"
    default n
config SPIKE_MUNGE
    bool "Strip extra fingerprints and non-host candidates on device"
    default n

config SPIKE_ACTIVE_OFFER
    bool "Offer active DTLS to align esp_peer and aiortc SCTP initiators"
    default y
