# dg-esp32 common defaults: ESP32-S3, 16MB flash; PSRAM selected by board overlay.
# Persistent Kconfig choices go here; sdkconfig itself is generated.

CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM (octal, 80MHz) and let malloc use it for large allocations
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# CPU at full speed
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# C++: exceptions on (the Pipecat C++ client throws), with an emergency pool
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Console over the built-in USB-Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Pipecat pthread defaults; configure_threads overrides stacks to 12 KiB.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# esp_peer DTLS/SRTP and explicit external core/client task stacks.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# 1 ms scheduling is required for the 20 ms playout clock with codec work.
CONFIG_FREERTOS_HZ=1000
# Duplex Opus plus the C++ message dispatcher thrashes the 16 KiB I-cache.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Step 6 measured internal-RAM settings.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_DG_PLAYBACK_GAIN_PERCENT=33

# Phase 6a observability; stats snapshots run outside media workers.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_DG_PHASE1_DIAGNOSTICS=y

CONFIG_DG_PEER_PEM_PSRAM=n
CONFIG_DG_FAST_MIC_DIAGNOSTICS=y

# Step 6b sweep-derived playback staging.
CONFIG_DG_PLAYBACK_CEILING_PERCENT=26
CONFIG_DG_PLAYBACK_HIGHPASS_HZ=500
CONFIG_DG_PLAYBACK_STACK_BYTES=17152

# Fixed 140 ms reserve (7 x 20 ms, aec-v86 0e44051); ten frames bound the
# contiguous READY backlog. Both images use these values.
CONFIG_DG_PLAYOUT_TARGET_FRAMES=7
CONFIG_DG_PLAYOUT_MAX_TARGET_FRAMES=10

# Step 6a measured configuration.
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# Worker reuse and TX stack defaults are conditional in peer Kconfig; the owner
# (peer-loop) stack defaults to 12800 in every mode (decision 111(a)).
CONFIG_DG_PEER_RX_STACK_BYTES=4096

# Bench-only: runtime playback settings and lazy 960 KB PSRAM capture for HIL.
CONFIG_DG_SPEAKER_DIAGNOSTICS=y

# Step 6a measured configuration.
CONFIG_DG_PEER_FULL_CALL_TIMING=n
CONFIG_DG_PEER_ARRIVAL_TRACE=n
CONFIG_DG_PEER_DIRECT_SOCKET_SELECT=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Step 8b speech DSP; qualification is recorded in step-8b-report.md.
CONFIG_DG_PLAYBACK_NORMALIZE=y
CONFIG_DG_PLAYBACK_TARGET_DBFS=-22
CONFIG_DG_PLAYBACK_MAX_GAIN_DB=18
CONFIG_DG_PLAYBACK_ACTIVITY_DBFS=-45
CONFIG_DG_PLAYBACK_LEVEL_MS=400
CONFIG_DG_PLAYBACK_ATTACK_MS=100
CONFIG_DG_PLAYBACK_RELEASE_MS=1000
CONFIG_DG_PLAYBACK_LOOKAHEAD_MS=2
CONFIG_DG_PLAYBACK_LIMITER_RELEASE_MS=75
CONFIG_DG_PLAYBACK_COMPRESSION_RATIO=3
CONFIG_DG_PLAYBACK_COMPRESSION_THRESHOLD_DBFS=-18

# Step 8d2: +18.06 dB input gain; native mic diagnostics remain pre-gain.
CONFIG_DG_MIC_GAIN_PERCENT=1600

# Full lwIP statistics are enabled only in the step-8c bench overlay.
CONFIG_LWIP_STATS=n

CONFIG_ESPTOOLPY_FLASHMODE_QIO=n

CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

CONFIG_DG_PEER_JITTER_TIMEOUT_MS=200

CONFIG_DG_PEER_RECV_TIMEOUT_MS=20

CONFIG_DG_OPUS_UPLINK_FRAME40=n

# Step 8c RAM: direct select/recv timeout add no buffer capacity.
# Mailbox32: +104 B per UDP socket, plus retained netbuf/pbuf payloads.
# Cache200: existing 16384 B capacity unchanged; longer retention.
# Frame40: +3072 B internal TX stack and about 1.3 KB PSRAM batching.
CONFIG_DG_OPUS_FEC=n
CONFIG_DG_CODEC_EAGER_INITIALIZATION=y
CONFIG_DG_OPUS_ENCODER_HOT_IRAM=n
CONFIG_DG_CODEC_LAYOUT_TRACE=n
CONFIG_DG_PLAYBACK_DSP_IRAM=n
CONFIG_DG_PLAYBACK_BREAKDOWN=n
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_DG_CACHE_COUNTERS=n
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=128
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_OBJ_NAME_LEN=80
CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y
