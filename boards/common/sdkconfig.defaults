# Board-neutral policy from root sdkconfig.defaults; root stays the S3 source.
# scripts/test_check_sdkconfig.py enforces exact key/value coverage and drift.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_DG_PLAYBACK_GAIN_PERCENT=33
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_DG_PHASE1_DIAGNOSTICS=y
CONFIG_DG_PEER_PEM_PSRAM=n
CONFIG_DG_FAST_MIC_DIAGNOSTICS=y
CONFIG_DG_PLAYBACK_CEILING_PERCENT=26
CONFIG_DG_PLAYBACK_HIGHPASS_HZ=500
CONFIG_DG_PLAYBACK_STACK_BYTES=17152
CONFIG_DG_PLAYOUT_TARGET_FRAMES=7
CONFIG_DG_PLAYOUT_MAX_TARGET_FRAMES=10
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_DG_PEER_RX_STACK_BYTES=4096
CONFIG_DG_SPEAKER_DIAGNOSTICS=y
CONFIG_DG_PEER_FULL_CALL_TIMING=n
CONFIG_DG_PEER_ARRIVAL_TRACE=n
CONFIG_DG_PEER_DIRECT_SOCKET_SELECT=y
CONFIG_DG_PLAYBACK_NORMALIZE=y
CONFIG_DG_PLAYBACK_TARGET_DBFS=-22
CONFIG_DG_PLAYBACK_MAX_GAIN_DB=18
CONFIG_DG_PLAYBACK_ACTIVITY_DBFS=-45
CONFIG_DG_PLAYBACK_LEVEL_MS=400
CONFIG_DG_PLAYBACK_ATTACK_MS=100
CONFIG_DG_PLAYBACK_RELEASE_MS=1000
CONFIG_DG_PLAYBACK_LOOKAHEAD_MS=2
CONFIG_DG_PLAYBACK_LIMITER_RELEASE_MS=75
CONFIG_DG_PLAYBACK_COMPRESSION_RATIO=3
CONFIG_DG_PLAYBACK_COMPRESSION_THRESHOLD_DBFS=-18
CONFIG_DG_MIC_GAIN_PERCENT=1600
CONFIG_LWIP_STATS=n
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_DG_PEER_JITTER_TIMEOUT_MS=200
CONFIG_DG_PEER_RECV_TIMEOUT_MS=20
CONFIG_DG_OPUS_UPLINK_FRAME40=n
CONFIG_DG_OPUS_FEC=n
CONFIG_DG_CODEC_EAGER_INITIALIZATION=y
CONFIG_DG_OPUS_ENCODER_HOT_IRAM=n
CONFIG_DG_CODEC_LAYOUT_TRACE=n
CONFIG_DG_PLAYBACK_DSP_IRAM=n
CONFIG_DG_PLAYBACK_BREAKDOWN=n
CONFIG_DG_CACHE_COUNTERS=n
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=128
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_OBJ_NAME_LEN=80
CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y
