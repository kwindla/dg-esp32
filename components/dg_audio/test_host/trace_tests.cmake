# The permanent gate uses reviewed text fixtures, with no historical source or
# Git-history dependency. Rebase policy is documented in test_codec_trace.py.
# compare_pre_refactor.py provides the optional one-shot old-source witness.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(vendor "${AUDIO_TRACE_VENDOR_ROOT}")
add_library(trace_vendor STATIC "${vendor}/device/es8311/es8311.c" "${vendor}/device/es7210/es7210.c" "${vendor}/esp_codec_dev_vol.c")
target_include_directories(trace_vendor PUBLIC trace_fakes "${vendor}/include" "${vendor}/interface" "${vendor}/device/include" "${vendor}/device/priv_include")
target_compile_options(trace_vendor PRIVATE -include "${CMAKE_CURRENT_SOURCE_DIR}/trace_fakes/sdkconfig.h")
set(AUDIO_TRACE_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.." CACHE PATH "Candidate production source for trace/mutation tests")
foreach(board echoear echoear_aec waveshare146 p4xc)
 set(target trace_${board}_after)
 set(sources "${AUDIO_TRACE_SOURCE_ROOT}/src/mic.cpp" "${AUDIO_TRACE_SOURCE_ROOT}/src/speaker.cpp")
 if(board STREQUAL waveshare146)
  list(APPEND sources "${AUDIO_TRACE_SOURCE_ROOT}/src/codec/direct_i2s.cpp")
 else()
  list(APPEND sources "${AUDIO_TRACE_SOURCE_ROOT}/src/codec/es8311_es7210.cpp" "${AUDIO_TRACE_SOURCE_ROOT}/src/codec/i2s_duplex.cpp" "${AUDIO_TRACE_SOURCE_ROOT}/src/codec/playback.cpp")
 endif()
 if(board STREQUAL waveshare146)
  set(board_source ../../dg_board/src/waveshare146/audio_hw.cpp)
 elseif(board STREQUAL p4xc)
  set(board_source ../../dg_board/src/p4xc/audio_hw.cpp)
 else()
  set(board_source ../../dg_board/src/echoear/audio_hw.cpp)
 endif()
 add_executable(${target} trace_hardware.cpp ${sources} ${board_source})
 target_include_directories(${target} BEFORE PRIVATE trace_fakes fakes ../../dg_diagnostics/include "${AUDIO_TRACE_SOURCE_ROOT}/src")
 target_link_libraries(${target} PRIVATE trace_vendor)
 if(board MATCHES "^echoear")
  target_compile_definitions(${target} PRIVATE CONFIG_DG_BOARD_ECHOEAR=1)
 endif()
 if(board STREQUAL echoear_aec)
  target_compile_definitions(${target} PRIVATE CONFIG_DG_ECHOEAR_AEC=1)
 endif()
 add_test(NAME trace.${board} COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/test_codec_trace.py"
  "$<TARGET_FILE:${target}>" ${board})
endforeach()

foreach(board echoear waveshare146 p4xc)
 add_executable(slots_${board} test_log_sink.cpp test_slot_maps.cpp ../../dg_board/src/${board}/audio_hw.cpp)
 target_include_directories(slots_${board} PRIVATE trace_fakes)
 if(board STREQUAL p4xc)
  target_compile_definitions(slots_${board} PRIVATE DG_TEST_P4_TDM=1)
 endif()
 if(board STREQUAL echoear)
  target_compile_definitions(slots_${board} PRIVATE DG_TEST_PAIRED_CODEC=1)
 endif()
 target_link_libraries(slots_${board} PRIVATE GTest::gtest_main)
 gtest_discover_tests(slots_${board} TEST_PREFIX ${board}.)
endforeach()
